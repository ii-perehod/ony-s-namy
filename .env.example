# Replicate API (https://replicate.com — sign up for free token)
REPLICATE_API_TOKEN=r8_your_token_here

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRICE_ID=price_your_price_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe subscription price IDs (create recurring prices in Stripe Dashboard)
STRIPE_SUB_PRICE_30=price_sub_30_photos_per_month
STRIPE_SUB_PRICE_100=price_sub_100_photos_per_month
STRIPE_SUB_PRICE_UNLIMITED=price_sub_unlimited_per_month

# App settings
FREE_PHOTOS_LIMIT=3
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# Replicate API (https://replicate.com — sign up for free token)
REPLICATE_API_TOKEN=r8_your_token_here

# YooKassa (https://yookassa.ru/my — личный кабинет)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# App settings
FREE_PHOTOS_LIMIT=5
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
